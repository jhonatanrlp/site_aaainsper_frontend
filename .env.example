# Backend API base URL — every application data request goes here.
VITE_API_BASE_URL=http://localhost:3000

# Supabase project — used ONLY for Auth (OTP login/session/refresh/sign-out).
# The frontend never queries Postgres or Storage directly; the anon key is
# safe to expose (it's the standard client-side Supabase key).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me

# Real (UX-only) enforcement mirrors the backend's ALLOWED_EMAIL_DOMAIN —
# the backend is the actual enforcement point.
VITE_ALLOWED_EMAIL_DOMAIN=al.insper.edu.br
